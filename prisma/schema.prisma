generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  passwordHash String
  role         String        @default("USER") // USER or ADMIN
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tasks        Task[]
  projects     Project[]
  achievements Achievement[]
  notes        DailyNote[]
  weeklyReports WeeklyReport[]
  monthlyReports MonthlyReport[]
  reviews      Review[]
  categories   Category[]
  settings     Setting[]
  cliCommands  CliCommand[]
  cliLogs      CliExecutionLog[]
  apiKeys      ApiKey[]
  agents       Agent[]
}

model ApiKey {
  id         String   @id @default(cuid())
  name       String
  keyHash    String   @unique
  keyPrefix  String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
}

model Agent {
  id              String   @id @default(cuid())
  name            String
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String   @default("offline") // online/offline
  lastSeenAt      DateTime?
  version         String?
  hostname        String?
  os              String?
  arch            String?
  commandWhitelist String  @default("[]") // JSON array of allowed command patterns
  allowCustomCommands Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  pendingTasks    AgentPendingTask[]
  logs            CliExecutionLog[]

  @@unique([userId, name])
}

model AgentPendingTask {
  id          String   @id @default(cuid())
  agentId     String
  agent       Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  commandId   String
  command     String
  cwd         String?
  timeout     Int      @default(30000)
  triggeredBy String   @default("schedule") // schedule/manual
  status      String   @default("pending") // pending/sent/running/completed/failed/timeout
  output      String?
  error       String?
  durationMs  Int?
  createdAt   DateTime @default(now())
  executedAt  DateTime?
  completedAt DateTime?
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String     @default("")
  status      String     @default("todo")
  priority    String     @default("medium")
  category    String     @default("")
  tags        String     @default("")
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isConverted Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  achievement Achievement?
  notes       DailyNote[]
}

model Project {
  id          String     @id @default(cuid())
  name        String
  description String     @default("")
  status      String     @default("active")
  priority    String     @default("medium")
  progress    Int        @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks       Task[]
  achievements Achievement[]
}

model Achievement {
  id          String     @id @default(cuid())
  title       String
  taskId      String?    @unique
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  scenario    String     @default("")
  result      String     @default("")
  output      String     @default("")
  value       String     @default("")
  category    String     @default("")
  date        DateTime   @default(now())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DailyNote {
  id          String     @id @default(cuid())
  content     String
  date        DateTime   @default(now())
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  mood        String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyReport {
  id               String   @id @default(cuid())
  weekStart        DateTime
  weekEnd          DateTime
  tasksCompleted   Int      @default(0)
  projectsCount    Int      @default(0)
  achievementsCount Int     @default(0)
  summary          String   @default("")
  issues           String   @default("")
  nextPlan         String   @default("")
  isAuto           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MonthlyReport {
  id                   String   @id @default(cuid())
  month                DateTime
  tasksCompleted       Int      @default(0)
  projectsCount        Int      @default(0)
  achievementsCount    Int      @default(0)
  collaborationsCount  Int      @default(0)
  summary              String   @default("")
  isAuto               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id                      String   @id @default(cuid())
  month                   DateTime
  achievementCategories   String   @default("[]")
  investmentDistribution  String   @default("[]")
  trends                  String   @default("[]")
  summary                 String   @default("")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String   @id @default(cuid())
  name      String
  type      String
  color     String   @default("")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  id        String   @id @default(cuid())
  key       String
  value     String   @default("")
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model CliCommand {
  id           String   @id @default(cuid())
  name         String
  command      String
  cwd          String?
  schedule     String   // cron expression
  outputType   String   @default("text") // text or json
  fieldMapping String   @default("{}") // JSON field mapping config
  importType   String   @default("auto") // auto(AI解析)/note/task/achievement
  useAI        Boolean  @default(true) // whether to use AI to parse output
  enabled      Boolean  @default(true)
  lastRunAt    DateTime?
  runTarget    String   @default("server") // server/agent
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs         CliExecutionLog[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CliExecutionLog {
  id            String   @id @default(cuid())
  commandId     String
  command       CliCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  status        String   // success/failed
  output        String   // raw output
  error         String?  // error message
  importedCount Int      @default(0)
  executedAt    DateTime @default(now())
  durationMs    Int      @default(0)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
